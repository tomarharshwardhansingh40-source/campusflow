generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  faculty
}

enum Category {
  general
  event
  exam
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(student)
  createdAt    DateTime @default(now())

  // Relations
  coursesAuthored Course[]       @relation("FacultyCourses")
  enrollments     Enrollment[]
  announcements   Announcement[]
  assignments     Assignment[]
  resources       Resource[]

  @@map("users")
}

model Course {
  id        String   @id @default(uuid())
  code      String
  name      String
  facultyId String
  createdAt DateTime @default(now())

  // Relations
  faculty       User           @relation("FacultyCourses", fields: [facultyId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  announcements Announcement[]
  assignments   Assignment[]
  resources     Resource[]

  @@index([facultyId])
  @@map("courses")
}

model Enrollment {
  id       String   @id @default(uuid())
  userId   String
  courseId String
  joinedAt DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Announcement {
  id        String    @id @default(uuid())
  courseId  String?
  authorId  String
  title     String
  body      String    @db.Text
  category  Category  @default(general)
  eventDate DateTime?
  createdAt DateTime  @default(now())

  // Relations
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([authorId])
  @@map("announcements")
}

model Assignment {
  id          String   @id @default(uuid())
  courseId    String
  authorId    String
  title       String
  description String   @db.Text
  dueDate     DateTime
  createdAt   DateTime @default(now())

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([authorId])
  @@index([dueDate])
  @@map("assignments")
}

model Resource {
  id          String   @id @default(uuid())
  courseId    String
  uploaderId  String
  title       String
  description String   @db.Text
  linkUrl     String?
  contentText String?  @db.Text
  createdAt   DateTime @default(now())

  // Relations
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploader User   @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([uploaderId])
  @@map("resources")
}
